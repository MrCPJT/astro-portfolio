---
import Layout from "@/app/layouts/Layout.astro";
import Animation from "@/app/components/Animation.astro";
---

<Layout
  title="Page not found | Connor Tynan"
  description="The page you were looking for does not exist."
>
  <Animation>
    <section class="space-y-4">
      <h1 class="text-3xl font-bold text-[var(--color-text)]">
        Page not found
      </h1>
      <p class="text-[var(--color-text-muted)]">
        That page does not exist or has moved.
      </p>
      <p class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="/"
          class="button-primary inline-flex items-center rounded-md px-4 py-2 text-sm font-medium transition-colors"
        >
          Home
        </a>
        <a
          href="/projects"
          class="button-secondary inline-flex items-center rounded-md border px-4 py-2 text-sm font-medium transition-colors"
        >
          Projects
        </a>
        <a
          href="/blog"
          class="button-secondary inline-flex items-center rounded-md border px-4 py-2 text-sm font-medium transition-colors"
        >
          Blog
        </a>
      </p>
    </section>
  </Animation>
</Layout>
