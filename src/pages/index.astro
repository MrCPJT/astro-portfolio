---
import Layout from "@/app/layouts/Layout.astro";
import Animation from "@/app/components/Animation.astro";
import CareerTimeline from "@/components/home/CareerTimeline.astro";
import FeaturedProjectCard from "@/components/home/FeaturedProjectCard.astro";
import { getAllBlogPosts } from "@/app/api/blog";
import { getAllProjects } from "@/app/api/projects";
import { EDUCATION, EXPERIENCE } from "@/app/static/experience";
import { FEATURED_PROJECTS } from "@/app/static/consts";

const timeline = [...EXPERIENCE, ...EDUCATION].sort(
  (a, b) => b.start.getTime() - a.start.getTime(),
);

const projects = await getAllProjects();
const featuredProjects = FEATURED_PROJECTS.flatMap((slug) =>
  projects.filter((project) => project.slug === slug),
);

const recentPosts = (await getAllBlogPosts())
  .filter((post) => !post.data.draft)
  .slice(0, 3);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  }).format(date);
---

<Layout
  title="Connor Tynan | Portfolio"
  description="Portfolio and writings from a data scientist."
>
  <Animation>
    <div class="flex flex-col items-start space-y-6">
      <h1 class="text-3xl font-bold text-[var(--color-text)]">Connor Tynan</h1>
      <section>
        <h2 class="text-xl text-[var(--color-text-muted)]">
          Research scientist interested in Applied AI.
        </h2>

        <article class="text-base text-gray">
          <p>
            Data scientist with two years of experience working across several
            domains, including MRI, photovoltaics, QRNG, and healthcare.
          </p>

          <p>
            This site collects some of my personal projects, writings, and
            resume.
          </p>

          <p class="flex flex-wrap gap-3 pt-3">
            <a
              href="/resume"
              class="button-primary inline-flex items-center rounded-md px-4 py-2 text-sm font-medium transition-colors"
              aria-label="View resume"
            >
              Resume
            </a>
            <a
              href="/projects"
              class="button-secondary inline-flex items-center rounded-md border px-4 py-2 text-sm font-medium transition-colors"
              aria-label="View data science projects"
            >
              Projects
            </a>
          </p>
        </article>
      </section>
    </div>

    <section class="mt-12">
      <Animation delay={0.2}>
        <h2 class="mb-4 text-2xl text-[var(--color-text-muted)]">Experience</h2>
        <CareerTimeline entries={timeline} />
      </Animation>
    </section>

    <section class="mt-12">
      <Animation delay={0.3}>
        <div class="mb-4 flex items-baseline justify-between">
          <h2 class="text-2xl text-[var(--color-text-muted)]">
            Selected projects
          </h2>
          <a href="/projects" class="link-accent text-sm hover:underline">
            All projects
          </a>
        </div>
        <div class="grid grid-cols-1 gap-4 tablet:grid-cols-2">
          {
            featuredProjects.map((project) => (
              <FeaturedProjectCard project={project} />
            ))
          }
        </div>
      </Animation>
    </section>

    <section class="mt-12">
      <Animation delay={0.4}>
        <div class="mb-4 flex items-baseline justify-between">
          <h2 class="text-2xl text-[var(--color-text-muted)]">
            Latest writing
          </h2>
          <a href="/blog" class="link-accent text-sm hover:underline">
            All posts
          </a>
        </div>
        <ul class="border-b border-[var(--color-border)]">
          {
            recentPosts.map((post) => (
              <li class="border-t border-[var(--color-border)]">
                <a
                  href={`/blog/${post.slug}`}
                  class="group flex flex-col gap-1 py-3 tablet:flex-row tablet:items-baseline tablet:justify-between tablet:gap-4"
                >
                  <span class="font-medium transition-colors group-hover:text-[var(--color-primary)]">
                    {post.data.title}
                  </span>
                  <time
                    datetime={post.data.date.toISOString()}
                    class="shrink-0 text-sm text-[var(--color-text-muted)]"
                  >
                    {formatDate(post.data.date)}
                  </time>
                </a>
              </li>
            ))
          }
        </ul>
      </Animation>
    </section>
  </Animation>
</Layout>
