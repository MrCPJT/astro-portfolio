---
import fs from "node:fs";
import Layout from "@/app/layouts/Layout.astro";
import Animation from "@/app/components/Animation.astro";

const PDF_PATH = "/resume/connor-tynan-resume.pdf";
const sizeKb = Math.round(fs.statSync(`public${PDF_PATH}`).size / 1024);
---

<Layout
  title="Resume | Connor Tynan"
  description="Download the resume of Connor Tynan as a PDF."
>
  <Animation>
    <section class="space-y-6">
      <div>
        <h1 class="text-3xl font-bold text-[var(--color-text)]">Resume</h1>
        <p class="mt-3 text-[var(--color-text-muted)]">
          My experience, education and skills in a single document.
        </p>
      </div>

      <div
        class="surface-card flex flex-col gap-4 rounded-lg border p-5 tablet:flex-row tablet:items-center tablet:justify-between"
      >
        <div>
          <p class="font-semibold">Connor Tynan, resume</p>
          <p class="text-sm text-[var(--color-text-muted)]">PDF, {sizeKb} KB</p>
        </div>
        <a
          href={PDF_PATH}
          download
          type="application/pdf"
          class="button-primary inline-flex items-center justify-center rounded-md px-5 py-2.5 text-sm font-medium transition-colors"
        >
          Download resume
        </a>
      </div>

      <p class="text-sm text-[var(--color-text-muted)]">
        Looking for the short version? My experience and skills are on the
        <a href="/" class="link-accent hover:underline">home page</a>.
      </p>
    </section>
  </Animation>
</Layout>
