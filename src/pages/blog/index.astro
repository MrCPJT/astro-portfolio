---
import Layout from "@/app/layouts/Layout.astro";
import Animation from "@/app/components/Animation.astro";
import BlogPage from "@/components/blog/BlogPage";
import type { BlogPostSummary } from "@/components/blog/types";
import { getAllBlogPosts } from "@/app/api/blog";

const dateLabel = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

// The island is hydrated from these props, so they carry only what a card
// shows. Passing whole entries would ship every post body to the browser.

const posts: BlogPostSummary[] = (await getAllBlogPosts()).map(
  ({ id, data }) => ({
    slug: id,
    title: data.title,
    summary: data.summary,
    tags: data.tags,
    dateIso: data.date.toISOString(),
    dateLabel: dateLabel.format(data.date),
  }),
);

const allTags = [...new Set(posts.flatMap((post) => post.tags))].sort();
---

<Layout
  title="Blog | Connor Tynan"
  description="Writing on data science projects, analysis workflows, notebooks, and career notes."
>
  <Animation>
    <section class="space-y-6">
      <div>
        <h1 class="text-3xl font-bold text-[var(--color-text)]">Blog</h1>
        <p class="mt-3 text-[var(--color-text-muted)]">
          Writing on data science projects, analysis workflows, notebooks, and
          career notes.
        </p>
      </div>

      {/* The island has display: contents, so this div takes the spacing. */}
      <div>
        <BlogPage posts={posts} allTags={allTags} client:load />
      </div>
    </section>
  </Animation>
</Layout>
