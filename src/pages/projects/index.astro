---
import Layout from "@/app/layouts/Layout.astro";
import Animation from "@/app/components/Animation.astro";
import ProjectCard from "@/components/project/ProjectCard.astro";
import { getProjectGroups } from "@/app/api/projects";

const groups = await getProjectGroups();
const chipClass =
  "rounded-full border border-[var(--color-border)] px-3 py-1 text-sm text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-text)] focus-visible:outline-2 focus-visible:outline-[var(--color-focus)] aria-pressed:border-[var(--color-primary)] aria-pressed:bg-[var(--color-primary)] aria-pressed:text-[var(--color-button-contrast)]";
---

<Layout
  title="Projects | Connor Tynan"
  description="Data science case studies, notebook-backed analysis, and modelling projects."
>
  <Animation>
    <section class="space-y-6">
      <div>
        <h1 class="text-3xl font-bold text-[var(--color-text)]">Projects</h1>
        <p class="mt-3 text-[var(--color-text-muted)]">
          Selected data science work, written as case studies with context,
          methods, and outcomes.
        </p>
      </div>

      <div
        class="flex flex-wrap gap-2"
        role="group"
        aria-label="Filter projects by year"
        data-year-filter
      >
        <button type="button" class={chipClass} data-year="all" aria-pressed="true">
          All
        </button>
        {
          groups.map(({ key, label }) => (
            <button type="button" class={chipClass} data-year={key} aria-pressed="false">
              {label}
            </button>
          ))
        }
      </div>

      {
        groups.map(({ key, label, projects }) => (
          <section class="space-y-4" data-year-section={key} aria-labelledby={`year-${key}`}>
            <h2
              id={`year-${key}`}
              class="border-b border-[var(--color-border)] pb-2 text-xl font-semibold text-[var(--color-text)]"
            >
              {label}
            </h2>
            <ul class="list-none space-y-5 p-0">
              {projects.map((project) => (
                <li>
                  <ProjectCard project={project} variant="full" level={3} />
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </section>
  </Animation>
</Layout>

<script>
  // Re-bind on every client-side navigation, since ClientRouter swaps the page.

  document.addEventListener("astro:page-load", () => {
    const filter = document.querySelector("[data-year-filter]");
    if (!filter) return;

    const chips = filter.querySelectorAll<HTMLButtonElement>("button[data-year]");
    const sections = document.querySelectorAll<HTMLElement>("[data-year-section]");

    filter.addEventListener("click", (event) => {
      const chip = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-year]");
      if (!chip) return;

      const year = chip.dataset.year;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      sections.forEach((s) => {
        s.hidden = year !== "all" && s.dataset.yearSection !== year;
      });
    });
  });
</script>
