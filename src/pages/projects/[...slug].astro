---
import { getCollection } from "astro:content";
import Layout from "@/app/layouts/Layout.astro";
import Animation from "@/app/components/Animation.astro";
import Footer from "@/app/components/Footer.astro";
import ProjectFigure from "@/components/project/ProjectFigure.astro";
import ProjectSidebar from "@/components/project/ProjectSidebar.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  const sortedProjects = projects.sort(
    (a, b) =>
      new Date(b.data.startDate).getTime() -
      new Date(a.data.startDate).getTime(),
  );

  return sortedProjects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      ...project,
      prev:
        index + 1 < sortedProjects.length
          ? {
              slug: sortedProjects[index + 1].slug,
              title: sortedProjects[index + 1].data.title,
            }
          : undefined,
      next:
        index > 0
          ? {
              slug: sortedProjects[index - 1].slug,
              title: sortedProjects[index - 1].data.title,
            }
          : undefined,
    },
  }));
}

const project = Astro.props;
const { Content, headings } = await project.render();
const contents = headings.filter((heading) => heading.depth === 2);
---

<Layout
  title={`${project.data.title} | Connor Tynan`}
  description={project.data.summary}
>
  <div class="max-w-3xl mx-auto">
    <Animation>
      <header class="mb-8">
        <h1 class="text-3xl font-bold text-[var(--color-text)]">
          {project.data.title}
        </h1>
        {
          project.data.summary && (
            <p class="mt-3 text-lg text-[var(--color-text-muted)]">
              {project.data.summary}
            </p>
          )
        }
        {
          project.data.outcome && (
            <div class="mt-6 rounded-r-lg border-y border-r border-l-[3px] border-[var(--color-border)] border-l-[var(--color-primary)] bg-[var(--color-surface)] px-4 py-3">
              <p class="text-xs uppercase tracking-wide text-[var(--color-text-muted)]">
                Outcome
              </p>
              <p class="mt-1">{project.data.outcome}</p>
            </div>
          )
        }
      </header>
    </Animation>
    <Animation delay={0.2}>
      <div class="relative">
        <ProjectSidebar
          startDate={project.data.startDate}
          endDate={project.data.endDate}
          domain={project.data.domain}
          technologies={project.data.technologies}
          link={project.data.link}
          headings={contents}
        />
        {
          project.data.figure && (
            <ProjectFigure
              src={project.data.figure.src}
              alt={project.data.figure.alt}
              caption={project.data.figure.caption}
            />
          )
        }
        <article class="[&_h2]:scroll-mt-24">
          <Content />
        </article>
      </div>
    </Animation>
  </div>
  <Animation delay={0.3}>
    <Footer
      prevPost={project.prev}
      nextPost={project.next}
      postType="projects"
    />
  </Animation>
</Layout>
