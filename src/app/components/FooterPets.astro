---
// Pixel pets walking right to left along the top edge of the footer.
// Each sprite is a walk strip in public/sprites/pets/ (8 frames, or 16 for
// the hoppers), drawn at 2x.
//
// The strips are ground-locked: a planted foot moves back 1 native px per
// frame. So the pets travel in SCALE px steps, one per frame, and their feet
// stay put. Frames and travel steps share FRAME_MS, and every delay is a
// whole number of frames, so both animations step at the same instant.
//
// Every pet covers the same TRAVEL distance, starting SPACING px behind the
// one before. TRAVEL is longer than the widest track (max-w-6xl), so the
// parade loops without bunching on any screen width.

const SCALE = 2;
const FRAME_MS = 70;
const SPACING = 140; // px between pets

const PETS = [
  { name: "elephant", width: 24, height: 18, frames: 8 },
  { name: "trex", width: 20, height: 21, frames: 8 },
  { name: "duck", width: 19, height: 20, frames: 8 },
  { name: "crane", width: 20, height: 23, frames: 8 },
  { name: "triceratops", width: 26, height: 17, frames: 8 },
  { name: "frog", width: 32, height: 16, frames: 16 },
  { name: "fox", width: 26, height: 18, frames: 8 },
  { name: "pteranodon", width: 23, height: 23, frames: 8 },
  { name: "penguin", width: 18, height: 17, frames: 8 },
  { name: "stegosaurus", width: 24, height: 18, frames: 8 },
  { name: "flamingo", width: 16, height: 22, frames: 8 },
  { name: "brachiosaurus", width: 21, height: 21, frames: 8 },
  { name: "bunny", width: 32, height: 19, frames: 16 },
  { name: "velociraptor", width: 21, height: 21, frames: 8 },
  { name: "toucan", width: 22, height: 18, frames: 16 },
  { name: "ankylosaurus", width: 23, height: 14, frames: 8 },
  { name: "turtle", width: 21, height: 16, frames: 8 },
];

const TRAVEL = PETS.length * SPACING;
const STEPS = TRAVEL / SCALE;
const duration = (STEPS * FRAME_MS) / 1000;
---

<div
  class="pets"
  style={[
    `--travel: ${TRAVEL}px`,
    `--steps: ${STEPS}`,
    `--duration: ${duration}s`,
  ].join("; ")}
>
  {
    PETS.map((pet, i) => (
      <span
        class="pet"
        aria-hidden="true"
        style={[
          `width: ${pet.width * SCALE}px`,
          `height: ${pet.height * SCALE}px`,
          `--frames: ${pet.frames}`,
          `--cycle: ${pet.frames * FRAME_MS}ms`,
          `--sheet: ${pet.width * SCALE * pet.frames}px`,
          `background-image: url(/sprites/pets/${pet.name}.png)`,
          `background-size: ${pet.width * SCALE * pet.frames}px ${pet.height * SCALE}px`,
          `animation-delay: ${-((i * 3) % pet.frames) * FRAME_MS}ms, ${-(i * STEPS * FRAME_MS) / PETS.length}ms`,
        ].join("; ")}
      />
    ))
  }
</div>

<style>
  .pets {
    position: relative;
    height: 48px;
    overflow: hidden;
    container-type: inline-size;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 48px,
      black calc(100% - 48px),
      transparent
    );
  }

  .pet {
    position: absolute;
    bottom: 0;
    left: 0;
    background-repeat: no-repeat;
    image-rendering: pixelated;
    animation:
      pet-walk var(--cycle) steps(var(--frames)) infinite,
      pet-travel var(--duration) steps(var(--steps)) infinite;
  }

  @keyframes pet-walk {
    from { background-position: 0 0; }
    to { background-position: calc(var(--sheet) * -1) 0; }
  }

  @keyframes pet-travel {
    from { transform: translateX(100cqw); }
    to { transform: translateX(calc(100cqw - var(--travel))); }
  }

  /* Without motion, the pets stand in a row. */

  @media (prefers-reduced-motion: reduce) {
    .pets {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: 16px;
    }

    .pet {
      position: static;
      animation: none;
    }
  }
</style>
