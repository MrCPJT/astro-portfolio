---
import { FaSolidMagnifyingGlass } from "solid-icons/fa";
---

<site-search class={Astro.props.class}>
  <button
    data-open-modal
    disabled
    aria-label="search"
    aria-keyshortcuts="Control+K"
    class="flex h-10 items-center gap-2 rounded-lg px-3 text-[var(--color-text-muted)] transition-colors hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-primary)]"
  >
    <FaSolidMagnifyingGlass size={20} />
    <span class="hidden md:block text-sm">Search</span>
  </button>

  <dialog class="site-search-dialog" aria-label="Search">
    <div class="site-search-box" role="search">
      <input
        type="search"
        class="site-search-input"
        placeholder="Search the site"
        aria-label="Search the site"
        autocomplete="off"
        spellcheck="false"
      />
      <p class="site-search-status" role="status" aria-live="polite"></p>
      <ul class="site-search-results"></ul>
      <button type="button" class="site-search-more" hidden>
        Show more results
      </button>
    </div>
  </dialog>
</site-search>

<script is:inline src="/js/search.js"></script>

<style is:global>
  .site-search-dialog {
    position: fixed;
    inset: 8vh 0 auto 0;
    margin: 0 auto;
    padding: 0;
    width: min(40rem, calc(100% - 2rem));
    max-height: 80vh;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .site-search-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .site-search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .site-search-box {
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: 1rem;
  }

  .site-search-input {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 0.6rem 0.8rem;
    font: inherit;
    color: inherit;
    background: var(--color-background);
  }

  .site-search-input:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .site-search-status {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .site-search-status:empty {
    display: none;
  }

  .site-search-results {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    overflow-y: auto;
    overscroll-behavior: contain;
    transition: opacity 0.15s;
  }

  .site-search-results:empty {
    display: none;
  }

  .site-search-results[aria-busy="true"] {
    opacity: 0.55;
  }

  .site-search-results li + li {
    border-top: 1px solid var(--color-border);
  }

  .site-search-result {
    display: block;
    padding: 0.75rem 0.5rem;
    border-radius: 0.375rem;
    color: inherit;
    text-decoration: none;
  }

  .site-search-result:hover,
  .site-search-result:focus-visible {
    background: var(--color-surface-muted);
  }

  .site-search-result-title {
    display: block;
    font-weight: 600;
  }

  .site-search-result:hover .site-search-result-title,
  .site-search-result:focus-visible .site-search-result-title {
    color: var(--color-primary);
  }

  .site-search-result-excerpt {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .site-search-result-excerpt mark {
    border-radius: 0.2rem;
    padding: 0 0.1rem;
    color: inherit;
    background: color-mix(in srgb, var(--color-primary) 22%, transparent);
  }

  .site-search-more {
    margin-top: 0.5rem;
    align-self: flex-start;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    padding: 0.35rem 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    background: var(--color-surface);
  }

  .site-search-more:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
</style>
