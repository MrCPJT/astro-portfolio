---
import Search from "../components/Search.astro";
import FoxLogo from "../components/FoxLogo.astro";
import { FaSolidBars } from "solid-icons/fa";
import { LINKS } from "@/app/config/route";

const pathname = Astro.url.pathname;
---

<header>
  <nav
    class="fixed top-0 w-full border-b border-[var(--color-border)] bg-[var(--color-background)]/95 backdrop-blur-md z-10"
  >
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex justify-between h-16 items-center">
        <div class="flex items-center">
          <a
            href="/"
            class="mr-8 flex items-center"
            aria-label="Go to homepage"
          >
            <FoxLogo />
          </a>

          <div class="hidden md:flex space-x-6">
            {
              LINKS.map(({ href, title }) => (
                <a
                  href={href}
                  class:list={[
                    "group flex items-center text-base transition-colors",
                    {
                      "text-[var(--color-text)]":
                        pathname === href || pathname.startsWith(`${href}/`),
                    },
                    {
                      "text-[var(--color-text-muted)] hover:text-[var(--color-primary)]":
                        !(pathname === href || pathname.startsWith(`${href}/`)),
                    },
                  ]}
                >
                  <span class="hover-underline">{title}</span>
                </a>
              ))
            }
          </div>
        </div>

        <div class="flex items-center gap-2">
          <Search />
          <button
            type="button"
            class="theme-toggle inline-flex h-10 w-10 items-center justify-center rounded-md transition-colors hover:bg-[var(--color-surface-muted)]"
            aria-label="Toggle color theme"
            aria-pressed="false"
            data-theme-toggle
          >
            <span
              class="theme-icon theme-icon-sun hidden dark:inline-block"
              data-theme-icon="sun"></span>
            <span
              class="theme-icon theme-icon-moon inline-block dark:hidden"
              data-theme-icon="moon"></span>
          </button>
          <button
            class="ml-2 text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-primary)] md:hidden"
            aria-label="Menu"
            aria-expanded="false"
            aria-controls="nav-menu"
            data-toggle-nav
          >
            <FaSolidBars size={20} />
          </button>
        </div>
      </div>

      <div
        id="nav-menu"
        class="md:hidden max-h-0 overflow-hidden transition-all duration-300 ease-in-out"
        data-nav-menu
      >
        <div class="py-4 space-y-2">
          {
            LINKS.map(({ href, title }) => (
              <a
                href={href}
                class:list={[
                  "block py-2 px-4 text-base transition-colors",
                  {
                    "text-[var(--color-text)]":
                      pathname === href || pathname.startsWith(`${href}/`),
                  },
                  {
                    "text-[var(--color-text-muted)] hover:text-[var(--color-primary)]":
                      !(pathname === href || pathname.startsWith(`${href}/`)),
                  },
                ]}
              >
                <span class="hover-underline">{title}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  /*
   * Pixel sun and moon from public/sprites/*-toggle.png: 3 frames of 11×11,
   * drawn at 2x. The icon shows the mode a click switches to. Hover or focus
   * plays frames 2, 3, 2, 1 once, timed from art-work/sun-moon/toggle/.
   */

  .theme-icon {
    width: 22px;
    height: 22px;
    background: 0 0 / 66px 22px no-repeat;
    image-rendering: pixelated;
  }

  .theme-icon-sun {
    background-image: url("/sprites/sun-toggle.png");
  }

  .theme-icon-moon {
    background-image: url("/sprites/moon-toggle.png");
  }

  .theme-toggle:hover .theme-icon,
  .theme-toggle:focus-visible .theme-icon {
    animation: theme-icon-play 370ms step-end;
  }

  @keyframes theme-icon-play {
    0% { background-position: -22px 0; }
    18.92% { background-position: -44px 0; }
    62.16% { background-position: -22px 0; }
    81.08% { background-position: 0 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle:hover .theme-icon,
    .theme-toggle:focus-visible .theme-icon {
      animation: none;
    }
  }
</style>

<script is:inline src="/js/theme.js"></script>
<script is:inline src="/js/navigation.js"></script>
