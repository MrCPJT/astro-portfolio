---
import Search from "../components/Search.astro";
import FoxLogo from "../components/FoxLogo.astro";
import PixelIcon from "../components/PixelIcon.astro";
import { LINKS } from "@/app/config/route";

const pathname = Astro.url.pathname;

const isCurrent = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header" data-site-header>
  <div class="site-header-row">
    <a href="/" class="keycap fox-key" aria-label="Go to homepage">
      <FoxLogo />
      <span class="keycap-face keycap-face-icon">
        <span class="fox-head"></span>
      </span>
    </a>

    <div class="header-keys">
      <nav id="nav-menu" class="key-nav" aria-label="Main">
        {
          LINKS.map(({ href, title }) => (
            <a
              href={href}
              class="keycap"
              aria-current={isCurrent(href) ? "page" : undefined}
            >
              <span class="keycap-face">{title}</span>
            </a>
          ))
        }
      </nav>

      <div class="key-tools">
        <Search />
        <button
          type="button"
          class="keycap theme-toggle"
          aria-label="Toggle color theme"
          aria-pressed="false"
          data-theme-toggle
        >
          <span class="keycap-face keycap-face-icon">
            <span
              class="theme-icon theme-icon-sun hidden dark:inline-block"
              data-theme-icon="sun"></span>
            <span
              class="theme-icon theme-icon-moon inline-block dark:hidden"
              data-theme-icon="moon"></span>
          </span>
        </button>
        <button
          type="button"
          class="keycap menu-key"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="nav-menu"
          data-toggle-nav
        >
          <span class="keycap-face keycap-face-icon">
            <PixelIcon name="menu" class="menu-icon-open" />
            <PixelIcon name="close" class="menu-icon-close" />
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  /*
   * There is no bar. Each control is a free-standing keycap, and the page
   * fades out behind them as it scrolls under the top edge.
   */

  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    pointer-events: none;
  }

  .site-header::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    z-index: -1;
    height: 104px;
    background: linear-gradient(var(--color-background) 35%, transparent);
  }

  .site-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    max-width: 72rem;
    margin: 0 auto;
    padding: 14px 1rem 0;
  }

  .site-header-row > * {
    pointer-events: auto;
  }

  /*
   * At the top of the page the fox sits free. Once the page scrolls, it
   * swaps to its head on a key, so no sprite hangs over the text.
   */

  .fox-key {
    margin-top: -6px;
    padding: 0;
  }

  .fox-key .keycap-face {
    display: none;
  }

  .site-header[data-scrolled] .fox-key {
    margin-top: 0;
    padding: 2px 2px 6px;
  }

  .site-header[data-scrolled] .fox-key :global([data-fox-logo]) {
    display: none;
  }

  .site-header[data-scrolled] .fox-key .keycap-face {
    display: flex;
  }

  .fox-head {
    width: 32px;
    height: 32px;
    background: url("/sprites/fox-head.svg") center / 100% 100% no-repeat;
    image-rendering: pixelated;
  }

  .header-keys {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .key-nav,
  .key-tools {
    display: flex;
    gap: 10px;
  }

  .key-tools {
    margin-left: 8px;
  }

  .menu-key,
  .menu-icon-close,
  .menu-key[aria-expanded="true"] .menu-icon-open {
    display: none;
  }

  .menu-key[aria-expanded="true"] .menu-icon-close {
    display: block;
  }

  /* Below 768px the page keys drop in a column under the menu key. */

  @media (max-width: 767px) {
    .header-keys {
      gap: 0;
    }

    .key-tools {
      gap: 6px;
      margin-left: 0;
    }

    .menu-key {
      display: inline-block;
    }

    .key-nav {
      position: absolute;
      top: 54px;
      right: 0;
      display: none;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
    }

    .site-header[data-nav-open] .key-nav {
      display: flex;
    }

    .key-nav .keycap-face {
      height: 40px;
      padding: 0 18px;
      font-size: 0.9375rem;
    }
  }

  @media (max-width: 767px) and (prefers-reduced-motion: no-preference) {
    .site-header[data-nav-open] .key-nav .keycap {
      animation: key-drop 180ms steps(3) backwards;
    }

    .site-header[data-nav-open] .key-nav .keycap:nth-child(2) {
      animation-delay: 60ms;
    }

    .site-header[data-nav-open] .key-nav .keycap:nth-child(3) {
      animation-delay: 120ms;
    }

    .site-header[data-nav-open] .key-nav .keycap:nth-child(4) {
      animation-delay: 180ms;
    }
  }

  @keyframes key-drop {
    from {
      transform: translateY(-12px);
      opacity: 0;
    }
  }

  /*
   * Pixel sun and moon from public/sprites/*-toggle.png: 3 frames of 11×11,
   * drawn at 2x. The icon shows the mode a click switches to. Hover or focus
   * plays frames 2, 3, 2, 1 once, timed from art-work/sun-moon/toggle/.
   */

  .theme-icon {
    width: 22px;
    height: 22px;
    background: 0 0 / 66px 22px no-repeat;
    image-rendering: pixelated;
  }

  .theme-icon-sun {
    background-image: url("/sprites/sun-toggle.png");
  }

  .theme-icon-moon {
    background-image: url("/sprites/moon-toggle.png");
  }

  .theme-toggle:hover .theme-icon,
  .theme-toggle:focus-visible .theme-icon {
    animation: theme-icon-play 370ms step-end;
  }

  @keyframes theme-icon-play {
    0% { background-position: -22px 0; }
    18.92% { background-position: -44px 0; }
    62.16% { background-position: -22px 0; }
    81.08% { background-position: 0 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle:hover .theme-icon,
    .theme-toggle:focus-visible .theme-icon {
      animation: none;
    }
  }
</style>

<script is:inline src="/js/theme.js"></script>
<script is:inline src="/js/navigation.js"></script>
