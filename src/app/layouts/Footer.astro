---
import { FaSolidRss, FaBrandsLinkedinIn, FaBrandsGithub } from "solid-icons/fa";

import FooterPets from "../components/FooterPets.astro";

const today = new Date();
---

<footer class="relative mt-24 border-t border-[var(--color-border)] py-8">
  <div class="pointer-events-none absolute inset-x-0 bottom-[calc(100%+1px)]">
    <div class="max-w-6xl mx-auto px-4">
      <FooterPets />
    </div>
  </div>
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
      <p
        class="text-center text-sm text-[var(--color-text-muted)] sm:text-left"
      >
        &copy; {today.getFullYear()} Connor Tynan. All rights reserved. Adapted from
        the
        <a
          href="https://astro.build/themes/details/astro-fox/"
          class="underline hover:text-[var(--color-primary)]"
          target="_blank"
          rel="noopener noreferrer">Astro Fox</a
        > theme.
      </p>
      <div class="flex justify-center gap-4">
        <a
          href="/rss.xml"
          target="_blank"
          class="group"
          aria-label="Subscribe to RSS feed"
        >
          <FaSolidRss
            size={32}
            class="text-[var(--color-text)] transition-colors group-hover:text-[#F26522] group-focus-visible:text-[#F26522]"
          />
        </a>
        <a
          href="https://www.linkedin.com/in/cpjt"
          target="_blank"
          class="group"
          aria-label="Follow on LinkedIn"
        >
          <FaBrandsLinkedinIn
            size={32}
            class="text-[var(--color-text)] transition-colors group-hover:text-[#0A66C2] group-focus-visible:text-[#0A66C2]"
          />
        </a>
        <a
          href="https://github.com/MrCPJT"
          target="_blank"
          class="group"
          aria-label="View GitHub profile"
        >
          <FaBrandsGithub
            size={32}
            class="text-[var(--color-text)] transition-colors group-hover:text-[#8250DF] group-focus-visible:text-[#8250DF]"
          />
        </a>
      </div>
    </div>
  </div>
</footer>
