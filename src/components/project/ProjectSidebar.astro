---
import { Tag } from "@/components/common/Tag";
import { formatPeriod } from "@/app/utils/formatPeriod";

interface Props {
  startDate: Date;
  endDate?: Date;
  domain?: string;
  technologies: string[];
  link?: string;
  headings: { slug: string; text: string }[];
}

const { startDate, endDate, domain, technologies, link, headings } =
  Astro.props;

const linkLabel = link?.includes("github.com")
  ? "View on GitHub"
  : "View project";
---

<aside
  class="mb-8 desktop:absolute desktop:left-full desktop:top-0 desktop:mb-0 desktop:ml-8 desktop:h-full desktop:w-52"
>
  <div class="desktop:sticky desktop:top-24">
    <div class="surface-card rounded-lg border p-4 text-sm">
      <dl class="space-y-3">
        <div>
          <dt
            class="text-xs uppercase tracking-wide text-[var(--color-text-muted)]"
          >
            Period
          </dt>
          <dd>{formatPeriod(startDate, endDate)}</dd>
        </div>
        {
          domain && (
            <div>
              <dt class="text-xs uppercase tracking-wide text-[var(--color-text-muted)]">
                Domain
              </dt>
              <dd>{domain}</dd>
            </div>
          )
        }
        <div>
          <dt
            class="text-xs uppercase tracking-wide text-[var(--color-text-muted)]"
          >
            Stack
          </dt>
          <dd class="mt-1 flex flex-wrap gap-1.5">
            {technologies.map((tech) => <Tag>{tech}</Tag>)}
          </dd>
        </div>
      </dl>
      {
        link && (
          <a
            href={link}
            class="button-secondary mt-4 inline-flex items-center rounded-md border px-3 py-1.5 text-sm font-medium transition-colors"
            target="_blank"
            rel="noopener noreferrer"
          >
            {linkLabel}
          </a>
        )
      }
    </div>

    {
      headings.length > 0 && (
        <nav aria-label="On this page" class="mt-6 hidden desktop:block">
          <p class="mb-2 text-xs uppercase tracking-wide text-[var(--color-text-muted)]">
            On this page
          </p>
          <ul class="border-l-2 border-[var(--color-border)]">
            {headings.map((heading) => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  class="-ml-0.5 block border-l-2 border-transparent py-1 pl-3 text-sm text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</aside>
