---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Highlight {
  src: ImageMetadata;
  alt: string;
  title: string;
  caption: string;
}

interface Props {
  highlights: Highlight[];
}

const { highlights } = Astro.props;

const tiles = await Promise.all(
  highlights.map(async (highlight) => {
    const large = await getImage({ src: highlight.src, width: 1600 });
    return { ...highlight, href: large.src };
  }),
);
---

<section class="mb-10" aria-labelledby="highlights-heading">
  <h2
    id="highlights-heading"
    class="mb-3 text-xs font-normal uppercase tracking-wide text-[var(--color-text-muted)]"
  >
    Technical highlights
  </h2>
  <ul
    class="grid list-none grid-cols-2 gap-3 p-0 tablet:grid-cols-[repeat(auto-fit,minmax(10rem,1fr))]"
  >
    {
      tiles.map((tile) => (
        <li class="min-w-0">
          <a
            href={tile.href}
            target="_blank"
            rel="noopener noreferrer"
            class="surface-card group flex h-full w-full min-w-0 flex-col rounded-lg border p-2 transition-transform duration-200 hover:-translate-y-0.5 hover:border-[var(--color-primary)]"
            aria-label={`${tile.title}: open larger figure`}
          >
            <span class="flex aspect-[4/3] items-center justify-center overflow-hidden rounded bg-white">
              <Image
                src={tile.src}
                alt={tile.alt}
                widths={[240, 480]}
                sizes="(min-width: 640px) 12rem, 45vw"
                decoding="async"
                class="h-full w-full object-contain"
              />
            </span>
            <span class="mt-2 block text-sm font-semibold">{tile.title}</span>
            <span class="mt-0.5 block text-xs text-[var(--color-text-muted)]">
              {tile.caption}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
