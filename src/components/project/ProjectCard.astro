---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { Tag } from "@/components/common/Tag";
import { formatPeriod } from "@/app/utils/formatPeriod";

interface Props {
  project: CollectionEntry<"projects">;
  /** "compact" shows text only. "full" adds the cover figure and outcome. */
  variant?: "compact" | "full";
  /** Heading level, so the card fits the page outline. */
  level?: 2 | 3;
}

const { project, variant = "compact", level = 3 } = Astro.props;
const { title, summary, outcome, domain, startDate, endDate, technologies } =
  project.data;

const Heading = `h${level}` as "h2" | "h3";
const cover = project.data.highlights?.[0];
const full = variant === "full";
---

<a
  href={`/projects/${project.slug}`}
  class:list={[
    "surface-card group block h-full rounded-lg border shadow-sm transition-transform duration-200 hover:-translate-y-1 hover:border-[var(--color-primary)] dark:shadow-none",
    full ? "p-4 tablet:flex tablet:gap-5" : "p-5",
  ]}
>
  {
    full && cover && (
      <span class="mb-4 flex aspect-[4/3] items-center justify-center overflow-hidden rounded bg-white tablet:mb-0 tablet:w-52 tablet:flex-none">
        <Image
          src={cover.src}
          alt=""
          widths={[320, 640]}
          sizes="(min-width: 640px) 13rem, 100vw"
          decoding="async"
          class="h-full w-full object-contain"
        />
      </span>
    )
  }
  <div class="min-w-0">
    <Heading class="text-lg font-semibold">{title}</Heading>
    <span class="mt-1 block text-sm text-[var(--color-text-muted)]">
      {formatPeriod(startDate, endDate)}
      {domain && full && ` · ${domain}`}
    </span>
    <span class="mt-2 block text-sm text-[var(--color-text-muted)]">
      {summary}
    </span>
    {
      full && outcome && (
        <span class="mt-3 block border-l-[3px] border-[var(--color-primary)] pl-3 text-sm">
          <span class="block text-xs uppercase tracking-wide text-[var(--color-text-muted)]">
            Outcome
          </span>
          {outcome}
        </span>
      )
    }
    <span class="mt-4 flex flex-wrap gap-2">
      {technologies.slice(0, 4).map((tech) => <Tag>{tech}</Tag>)}
      {
        technologies.length > 4 && (
          <span class="self-center text-xs text-[var(--color-text-muted)]">
            +{technologies.length - 4} more
          </span>
        )
      }
    </span>
    {
      full && (
        <span class="mt-4 inline-block text-sm font-medium text-[var(--color-primary)] group-hover:underline">
          Read case study
        </span>
      )
    }
  </div>
</a>
