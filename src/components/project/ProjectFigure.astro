---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="mb-8">
  <div class="rounded-lg border border-[var(--color-border)] bg-white p-3">
    <Image
      src={src}
      alt={alt}
      widths={[480, 720, 960]}
      sizes="(min-width: 768px) 720px, 100vw"
      decoding="async"
      class="mx-auto h-auto max-h-[28rem] w-auto max-w-full"
    />
  </div>
  <figcaption class="mt-2 text-sm text-[var(--color-text-muted)]">
    {caption}
  </figcaption>
</figure>
